PROJECT_NAME=weeshop
TIMEZONE=Asia/Shanghai
USER_HOME=/home/kent
DRUPAL_PATH=../drupal
DATA_PATH=../data
CERT_PATH=../certs
SSL=false
DOMAIN=demo.weeshop.org
PHP_VERSION=8.5
PHP_OPCACHE=false
PHP_JIT=false
MYSQL_VERSION=9.7
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=drupal
DRUPAL_VERSION=11.4
DRUPAL_PROFILE=weeshop
DRUPAL_SITE_NAME=Weeshop
DRUPAL_SITE_EMAIL=admin@weeshop.org
DRUPAL_SITE_PASSWORD=admin
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_EMAIL=admin@weeshop.org
DRUPAL_ADMIN_PASSWORD=admin

CHROME_DRIVER_PATH=/home/kent/Downloads/chromedriver-linux64/chromedriver
CHROME_DRIVER_PORT=4444
CHROME_DRIVER_ALLOW_IPS=172.18.0.3
CHROME_DRIVER_ALLOW_HOSTS=host.docker.internal

SIMPLETEST_BASE_URL=http://demo.weeshop.org
SIMPLETEST_DB=mysql://root:123456@db/drupal
BROWSERTEST_OUTPUT_BASE_URL=http://demo.weeshop.org
BROWSERTEST_OUTPUT_DIRECTORY=/app/web/sites/simpletest/browser_output
MINK_DRIVER_ARGS_WEBDRIVER='["chrome", {"browserName":"chrome","chromeOptions":{"w3c":true,"args":["--disable-gpu","--no-sandbox","--headless"]}}, "http://host.docker.internal:4444"]'
