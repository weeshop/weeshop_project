# Comment these lines if you don't use Composer.
/drush/contrib/
/drupal/vendor/
/drupal/web/core/
/drupal/web/modules/*
/drupal/web/modules/custom
/drupal/web/themes/*
/drupal/web/themes/custom
/drupal/web/profiles/*
/drupal/web/libraries/
/drupal/web/.*
/config
/drupal/web/*.php
/drupal/web/web.config
/drupal/web/robots.txt
drupal_config

# Ignore sensitive information
/drupal/web/sites/*

# Ignore SimpleTest multi-site environment.
/drupal/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/
.editorconfig
.gitattributes

# Ignore vscode meta data.
/.vscode/

# Ignore docker data
/data
/SSL/
/.env